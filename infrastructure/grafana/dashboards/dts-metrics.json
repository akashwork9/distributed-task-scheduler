      "type": "stat",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(dts_tasks_executed_success_total[1m])",
          "legendFormat": "{{type}}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "title": "Retries & Failures / Sec",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(dts_tasks_retried_total_total[1m]) + rate(dts_tasks_dlq_total_total[1m])",
          "legendFormat": "Failures/Retries"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "title": "DLQ Events Received",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "dts_dlq_events_received_total_total",
          "legendFormat": "DLQ Events"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 6 },
      "id": 5,
      "title": "Execution Latency (p50, p95, p99)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(dts_task_execution_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p99 Latency"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(dts_task_execution_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p95 Latency"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(dts_task_execution_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p50 Latency"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 6 },
      "id": 6,
      "title": "JVM Memory & Heap Usage",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{area=\"heap\"}",
          "legendFormat": "Heap Used"
        },
        {
          "expr": "jvm_memory_max_bytes{area=\"heap\"}",
          "legendFormat": "Heap Max"
        }
      ]
    }
